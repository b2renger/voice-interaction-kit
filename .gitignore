# dependencies and build output
node_modules/
app/out/
dist/
# written by QVAC's Forge plugin when packaging (npm run package / make)
app/qvac/
# Zonos's in-browser engine, built by app/scripts/build-zonos-engine.mjs (npm run zonos:engine)
app/zonos-engine/
# lockfiles: only the kit's and the app's are kept, so that the tests and the releases install exactly those
# versions (npm ci). Regenerate them from a clean folder (no node_modules), or a platform's packages go missing.
package-lock.json
!/package-lock.json
!/app/package-lock.json
*.log
npm-debug.log*

# secrets: never commit an API key
.env
.env.*
!.env.example

# files written by the self-test and by tools
selftest-*.wav
smart_turn_audio_log/
.qvac-worker-backup/
__pycache__/
*.pyc
test-results/
playwright-report/

# operating systems and editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# files set aside for deletion
_to_delete/
